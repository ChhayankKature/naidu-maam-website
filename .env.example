VITE_FIREBASE_PROJECT_ID=cn-mam-website
VITE_FIREBASE_STORAGE_BUCKET=cn-mam-website.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=462565559824
VITE_FIREBASE_APP_ID=1:462565559824:web:73860122a0aae89bd20495
